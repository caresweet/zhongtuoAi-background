# ── Backend Production Dockerfile ──────────────────────────────────────────
# Multi-stage: builder installs deps, runtime is lean
FROM python:3.12-slim AS builder

WORKDIR /app

# Build deps — use Aliyun mirror for speed in China
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -i https://pypi.tuna.tsinghua.edu.cn/simple/ -r requirements.txt


# ── Runtime stage ──────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# Runtime system deps (lighter than build deps)
# libreoffice-headless NOT available on Debian Trixie — .doc→.docx conversion disabled for now
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY . .

# Ensure scripts in .local/bin are on PATH
ENV PATH=/root/.local/bin:$PATH

EXPOSE 8000

# Use Gunicorn with Uvicorn workers for production
#
# 🔴 WORKERS 默认 1，**不要调大**。
#    ReportSession 是**进程内存**对象（report_service.py 的 `self._sessions`），
#    多 worker 会让请求落到「没有该会话」的进程上 → 404「会话不存在或已过期」，
#    前端显示为随机的「会话已过期」；多个 worker 还会互相覆盖 sessions.json。
#    只有把会话挪到共享存储（Redis/DB）之后，才谈得上多 worker。
#    （2026-09-24 生产事故：WORKERS=2 导致上传材料随机报「会话已过期」）
CMD ["sh", "-c", "gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers ${WORKERS:-1} \
    --bind 0.0.0.0:8000 \
    --timeout 300 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 10000 \
    --max-requests-jitter 1000 \
    --access-logfile - \
    --error-logfile - \
    --log-level info"]
